    "work-docs/design/mockups/reading-light.png": { "significance": "skip", "rationale": "Reference mockup, not runtime code" },
    "work-docs/design/mockups/reading-dark.png": { "significance": "skip", "rationale": "Reference mockup, not runtime code" },
    "work-docs/design/mockups/reading-scrolled-light.png": { "significance": "skip", "rationale": "Reference mockup, not runtime code" },
    "work-docs/design/mockups/reading-scrolled-dark.png": { "significance": "skip", "rationale": "Reference mockup, not runtime code" },
    "test/unit/setup.test.ts": { "significance": "low", "rationale": "Phase shape still matches" },
    "test/unit/sidebar.test.ts": { "significance": "low", "rationale": "Assertions follow nav slots and pick payloads" },
    "test/unit/sidebar-html.test.ts": { "significance": "low", "rationale": "Markup checks that actions sit in chrome" }
  },
  "steps": [
    {
      "id": "commit-selected",
      "order": 10,
      "path": "src/model/setup.ts",
      "ranges": [
        { "start": 34, "end": 37 },
        { "start": 75, "end": 75 },
        { "start": 215, "end": 225 }
      ],
      "significance": "critical",
      "title": "A commit pick stays selected",
      "rationale": "History clicks no longer jump to generate",
      "notes": "pickCommitRev writes selected. Use commit later calls selectCommit with that rev. Back from generate restores the same pick."
    },
    {
      "id": "pick-payload",
      "order": 20,
      "path": "src/commands/index.ts",
      "ranges": [{ "start": 80, "end": 83 }],
      "significance": "high",
      "title": "pick: selects without confirming",
      "rationale": "The list posts a prefix; the header button posts the bare rev",
      "dependsOn": ["commit-selected"]
    },
    {
      "id": "nav-actions",
      "order": 30,
      "path": "src/model/sidebar.ts",
      "ranges": [
        { "start": 305, "end": 314 },
        { "start": 545, "end": 592 },
        { "start": 784, "end": 794 },
        { "start": 901, "end": 912 }
      ],
      "significance": "critical",
      "title": "Use, Start, and End are nav",
      "rationale": "The footer is only passive context now",
      "notes": "Start walkthrough stays in the header even when disabled. End walkthrough is nav so the walk chrome can place it under Next.",
      "dependsOn": ["commit-selected"]
    },
    {
      "id": "action-row",
      "order": 40,
      "path": "src/ui/sidebar-html.ts",
      "ranges": [
        { "start": 89, "end": 91 },
        { "start": 260, "end": 292 }
      ],
      "significance": "critical",
      "title": "Chrome is Back, title, action",
      "rationale": "The commitment stays at the top on a tall sidebar",
      "notes": "Narrow widths wrap the filled button onto a second pinned row. Reading keeps Previous / count / Next, then a quiet End line.",
      "dependsOn": ["nav-actions"]
    }
  ]
}
